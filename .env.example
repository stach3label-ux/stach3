[TEMPLATE]
# ── Required ──────────────────────────────────────────────────────────────────
# Discord bot token (Discord Developer Portal -> Applications -> Bot).
# Enable under "Privileged Gateway Intents": MESSAGE CONTENT INTENT = ON
DISCORD_BOT_TOKEN=

# One Postgres connection URI. Works with Neon, Supabase or self-hosted:
#   Neon      : postgres://user:pass@ep-xxx-region.aws.neon.tech/dbname?sslmode=require
#   Supabase  : postgres://postgres.xxxx@aws-0-xx.pooler.supabase.com:6543/postgres?sslmode=require
#   self-host : postgres://user:pass@host:5432/dbname
DATABASE_URL=

# ── HTTP server (optional tweaks) ────────────────────────────────────────────
# Port for the built-in health/callback/MCP server.
PORT=7860
# 0.0.0.0 = reachable from the internet (needed for /receipt and the MCP
# server). 127.0.0.1 = only reachable locally (pair with Caddy/nginx on 80/443).
HEALTH_HOST=0.0.0.0

# Optional shared secret for the /receipt endpoint. When set, requests must
# include ?secret=<same value>. Leave empty to disable the check.
CHECKOUT_RECEIPT_SECRET=

# ── Music (optional; requires your own Lavalink node) ────────────────────────
# Master switch: MUSIC_ENABLED=False (or 0) never registers music commands and
# never touches Lavalink. When True (default) but LAVALINK_PASSWORD is empty
# (or the node is unreachable), music commands reply "Lavalink is not configured".
# Do NOT run Lavalink on the same 150 MB VPS as the bot.
MUSIC_ENABLED=1
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
# Set to 1 if your Lavalink node is served over HTTPS.
LAVALINK_SSL=0

# ── Single-server lock (this open-source edition is not for commercial use) ──
# The bot permanently binds to the FIRST server that invites it and leaves any
# other server automatically. Set GUILD_ID to pin a specific server instead.
# Multi-server / commercial use requires a proper fork.
GUILD_ID=

# ── AI MCP server (optional) ───────────────────────────────────────────────
# Set a password to let AI assistants (Claude Desktop, claude.ai, Cursor, ...)
# connect to http://<this-host>:<PORT>/mcp through the OAuth connector flow:
# they ask for this password - no Discord login, no server selection. The AI
# can read/decide submissions, manage tickets and CREATE custom slash commands
# that go live immediately. Leave empty to disable the MCP server.
MCP_PASSWORD=

# ── AI spam screening (optional; any ONE key enables it) ─────────────────────
# Submissions are never blocked - flagged ones are just marked on the card.
SAMBANOVA_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
