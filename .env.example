# ── Required ──────────────────────────────────────────────────────────────────
# Discord bot token (Discord Developer Portal -> Applications -> Bot).
# Enable under "Privileged Gateway Intents": MESSAGE CONTENT INTENT = ON
DISCORD_BOT_TOKEN=

# One Postgres connection URI. Works with Neon, Supabase or self-hosted:
#   Neon      : postgres://user:pass@ep-xxx-region.aws.neon.tech/dbname?sslmode=require
#   Supabase  : postgres://postgres.xxxx@aws-0-xx.pooler.supabase.com:6543/postgres?sslmode=require
#   self-host : postgres://user:pass@host:5432/dbname
DATABASE_URL=

# ── HTTP server (optional tweaks) ────────────────────────────────────────────
# Port for the built-in health/callback/receipt server.
PORT=7860
# 0.0.0.0 = reachable from the internet (needed if a site calls /receipt).
# 127.0.0.1 = only reachable locally (pair with Caddy/nginx on 80/443).
HEALTH_HOST=0.0.0.0

# Optional shared secret for the /receipt endpoint. When set, requests must
# include ?secret=<same value>. Leave empty to disable the check.
CHECKOUT_RECEIPT_SECRET=

# ── Music (optional; requires your own Lavalink node) ────────────────────────
# Leave LAVALINK_PASSWORD empty to disable music. Do NOT run Lavalink on the
# same 150 MB VPS as the bot.
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
# Set to 1 if your Lavalink node is served over HTTPS.
LAVALINK_SSL=0

# ── AI spam screening (optional; any ONE key enables it) ─────────────────────
# Submissions are never blocked - flagged ones are just marked on the card.
SAMBANOVA_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
